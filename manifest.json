{
  "manifest_version": 3,
  "name": "LoopTV",
  "version": "0.8.0",
  "description": "De vrais GIFs animés KLIPY dans le chat Twitch.",
  "action": {
    "default_title": "LoopTV · LTV",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.klipy.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://www.twitch.tv/*"],
    "js": ["name-paints.js", "twitch.js"],
    "css": ["twitch.css", "name-paints.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["assets/demo.gif"],
    "matches": ["https://www.twitch.tv/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
